# Example .env for backend. Do NOT store real secrets in this file in the repo.
PORT=3000
NODE_ENV=development

# CORS
# CORS_ORIGIN=http://localhost:3000

# Firebase Admin (service account JSON)
# Place the service account JSON at ./config/firebase.json (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase.json

# Optional: Firebase Admin credentials as JSON string (for cloud deployments)
# FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}

# Optional: used only by scripts that exchange tokens (e.g. get-idtoken.ts)
# FIREBASE_API_KEY=your_firebase_api_key

# Firebase Cloud Messaging (FCM) - Sender ID (get from Firebase Console > Project Settings > Cloud Messaging)
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Automation
# AUTOMATION_CRON=0 8 * * *
# AUTOMATION_TZ=America/Caracas
# AUTOMATION_JOB_DISABLED=false

# Testing helpers
# TEST_DRY_RUN=true

# Notes:
# - This example contains placeholders only. Do not commit real credentials.
